         raise ValueError(f"{name} must be a positive integer")
 
 
+def _parse_peak_id(value: str) -> tuple[str, int, int] | None:
+    match = re.fullmatch(r"([^:\s]+):([0-9]+)-([0-9]+)", value)
+    if match is None:
+        return None
+    return match.group(1), int(match.group(2)), int(match.group(3))
+
