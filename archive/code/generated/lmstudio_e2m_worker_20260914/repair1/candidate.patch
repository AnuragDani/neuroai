+"""Offline HTTP HEAD evidence validator."""
+import hashlib
+
+MAX_BYTES = 65536
+MAX_CL_DIGITS = 19
+MAX_CL_VALUE = 2**63 - 1
+
+
+def _reject(reason: str) -> None:
+    raise ValueError(reason)
+
+
+def _validate_label(value: str, name: str) -> None:
+    if not isinstance(value, str) or not value:
+        _reject(f"{name} must be a non-empty string")
+    if any(ord(c) < 32 or ord(c) == 127 for c in value):
+        _reject(f"{name} contains control characters")
+
+
+def _parse_content_length(value: str) -> int:
+    if not value:
+        _reject("Content-Length is blank")
+    if len(value) > MAX_CL_DIGITS:
+        _reject("Content-Length has excessive digits")
+    if not value.isascii() or not value.isdigit():
+        _reject("Content-Length contains non-ASCII digits or invalid characters")
+    if value[0] in "+-":
+        _reject("Content-Length has a sign")
+    try:
+        n = int(value)
+    except ValueError:
+        _reject("Content-Length is not a valid integer")
+    if n < 1:
+        _reject("Content-Length must be positive")
+    if n > MAX_CL_VALUE:
+        _reject("Content-Length exceeds maximum")
+    return n
+
+
+def parse_head_evidence(raw_headers: bytes, *, url: str, observed_at: str) -> dict:
+    if not isinstance(raw_headers, bytes):
+        _reject("raw_headers must be bytes")
+    if len(raw_headers) > MAX_BYTES:
+        _reject("raw_headers exceeds maximum size")
+    _validate_label(url, "url")
+    _validate_label(observed_at, "observed_at")
+
+    if b"\r\n\r\n" not in raw_headers:
+        _reject("missing final CRLF CRLF terminator")
+    if raw_headers.count(b"\r\n\r\n") > 1:
+        _reject("multiple CRLF CRLF terminators")
+
+    header_block = raw_headers[: raw_headers.index(b"\r\n\r\n")]
+    lines = header_block.split(b"\r\n")
+    if not lines:
+        _reject("empty header block")
+
+    status_line = lines[0].decode("latin-1")
+    parts = status_line.split(" ", 2)
+    if len(parts) < 3:
+        _reject("malformed status line")
+    if not parts[0].startswith("HTTP/1."):
+        _reject("invalid HTTP version")
+    if not parts[1].isdigit() or len(parts[1]) != 3:
+        _reject("invalid status code")
+    http_status = int(parts[1])
+    if http_status != 200:
+        _reject(f"non-200 status: {http_status}")
+
+    headers: dict[str, list[str]] = {}
+    for line in lines[1:]:
+        if not line:
+            _reject("empty header line")
+        if line.startswith(b" ") or line.startswith(b"\t"):
+            _reject("obsolete folded header")
+        if b"\r" in line or b"\n" in line:
+            _reject("bare LF or CR in header")
+        if b":" not in line:
+            _reject("malformed header line")
+        name_bytes, value_bytes = line.split(b":", 1)
+        name = name_bytes.decode("latin-1")
+        if not name or any(c in name for c in " \t\r\n") or any(ord(c) < 32 or ord(c) == 127 for c in name):
+            _reject(f"invalid header name: {name!r}")
+        value = value_bytes.decode("latin-1").strip(" \t")
+        if any(ord(c) < 32 and c != "\t" for c in value):
+            _reject(f"control character in header value: {name!r}")
+        headers.setdefault(name.lower(), []).append(value)
+
+    if "transfer-encoding" in headers:
+        _reject("Transfer-Encoding is not allowed")
+
+    cl_values = headers.get("content-length")
+    if cl_values is None:
+        _reject("missing Content-Length")
+    if len(cl_values) > 1:
+        _reject("duplicate Content-Length")
+    if "," in cl_values[0]:
+        _reject("Content-Length contains comma list")
+    declared_payload_bytes = _parse_content_length(cl_values[0])
+
+    def _single(name: str) -> str | None:
+        vals = headers.get(name)
+        if vals is None:
+            return None
+        if len(vals) > 1:
+            _reject(f"duplicate {name} header")
+        return vals[0]
+
+    return {
+        "record_kind": "development_head_metadata",
+        "status": "SOURCE_METADATA_OBSERVED",
+        "url": url,
+        "observed_at": observed_at,
+        "http_status": 200,
+        "header_record_sha256": hashlib.sha256(raw_headers).hexdigest(),
+        "header_bytes": len(raw_headers),
+        "declared_payload_bytes": declared_payload_bytes,
+        "etag": _single("etag"),
+        "last_modified": _single("last-modified"),
+        "accept_ranges": _single("accept-ranges"),
+        "publisher_payload_checksum": None,
+        "body_bytes": 0,
+        "scientific_gate_effect": "NONE",
+    }
