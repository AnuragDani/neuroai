+class FakeClock:
+    """Deterministic monotonic clock; advances only when told to."""
+
+    def __init__(self, start: float = 1000.0):
+        self.now = start
+
+    def __call__(self) -> float:
+        return self.now
+
+    def advance(self, seconds: float) -> None:
+        self.now += seconds
+
+
+class FakeSignal:
+    """In-memory stand-in for the signal module used by the capture core."""
+
+    def __init__(self, *, supported: bool = True, main_thread: bool = True):
+        self.supported = supported
+        self.main_thread = main_thread
+        self.SIGALRM = 14
+        self.SIG_DFL = 0
+        self._handlers = {}
+        self._timers = {}
+        self.setitimer_calls = []
+
+    def getsignal(self):
+        return self
+
+    def getcurrentthread(self):
+        return threading.main_thread() if self.main_thread else threading.current_thread()
+
+    def main_thread(self):
+        return threading.main_thread()
+
+    def signal(self, signum, handler):
+        previous = self._handlers.get(signum, self.SIG_DFL)
+        self._handlers[signum] = handler
+        return previous
+
+    def setitimer(self, which, interval, interval2=None):
+        self.setitimer_calls.append((which, interval, interval2))
+        self._timers[which] = (interval, interval2)
+        return self._timers.get(which, (0.0, 0.0))
+
+    def getitimer(self, which):
+        return self._timers.get(which, (0.0, 0.0))
+
+    def has_active_timer(self):
+        for which, (interval, interval2) in self._timers.items():
+            if which == self.SIGALRM:
+                continue
+            if interval > 0 or interval2 > 0:
+                return True
+        return False
+
