+def test_exact_65536_record_succeeds(cap_module, monkeypatch, parser_module):
+    # Build a record whose full encoded length is exactly 65536 bytes.
+    prefix = b"HTTP/1.1 200 OK\r\n"
+    suffix = b"\r\n"
+    filler = b"X-Filler: " + b"a" * 40 + b"\r\n"
+    # Compute how many filler lines fit so total == 65536.
+    base = len(prefix) + len(suffix)
+    target = 65536
+    # Use a Content-Length line plus filler lines to reach exactly target.
+    cl_line = b"Content-Length: 1\r\n"
+    base += len(cl_line)
+    remaining = target - base
+    assert remaining % len(filler) == 0, "fixture must divide evenly"
+    count = remaining // len(filler)
+    data = prefix + cl_line + filler * count + suffix
+    assert len(data) == 65536
+    clock = FakeClock()
+    connection = FakeConnection(data, clock)
+    factory = FakeFactory(connection)
+    report = _run(cap_module, monkeypatch, factory)
+    assert report["capture_status"] == "CAPTURED"
+    assert report["header_bytes"] == 65536
+    assert report["header_record_sha256"] == hashlib.sha256(data).hexdigest()
+    assert report["metadata"] is not None
+    assert connection.sock._pos == 65536
+
