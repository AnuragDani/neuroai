+def test_total_cap_failure_across_many_small_fields(cap_module, monkeypatch):
+    # Many individually small header fields whose cumulative size exceeds 65536
+    # before any terminator appears.
+    lines = [b"HTTP/1.1 200 OK"]
+    total = len(lines[0]) + 2  # status line CRLF
+    i = 0
+    while total < 65536:
+        line = b"X-Field-" + str(i).encode("ascii") + b": " + b"v" * 50
+        lines.append(line)
+        total += len(line) + 2
+        i += 1
+    data = b"\r\n".join(lines)  # no final CRLF CRLF
+    assert len(data) > 65536
+    assert b"\r\n\r\n" not in data
+    clock = FakeClock()
+    connection = FakeConnection(data, clock)
+    factory = FakeFactory(connection)
+    report = _run(cap_module, monkeypatch, factory)
+    assert report["capture_status"] == "REFUSED"
+    assert report["reason"] == "HEADER_CAP"
+    assert report["header_bytes"] == 65536
+    assert connection.sock._pos == 65536
