+class FakeSocket:
+    """Byte-stream socket with per-read cost and optional failure injection."""
+
+    def __init__(self, data: bytes, *, per_read_cost: float = 0.0, fail_at: int | None = None):
+        self._data = data
+        self._pos = 0
+        self._per_read_cost = per_read_cost
+        self._fail_at = fail_at
+        self._timeout = None
+        self.closed = False
+
+    def settimeout(self, seconds):
+        self._timeout = seconds
+
+    def gettimeout(self):
+        return self._timeout
+
+    def recv(self, n):
+        if self.closed:
+            raise OSError("recv on closed socket")
+        if self._fail_at is not None and self._pos >= self._fail_at:
+            raise OSError("injected I/O failure")
+        if self._pos >= len(self._data):
+            return b""
+        chunk = self._data[self._pos : self._pos + n]
+        self._pos += len(chunk)
+        return chunk
+
+
+class FakeConnection:
+    """HTTPSConnection-like object driven by a fake socket and clock."""
+
+    def __init__(self, data: bytes, clock: FakeClock, *, per_read_cost: float = 0.0,
+                 fail_at: int | None = None, connect_cost: float = 0.0,
+                 request_cost: float = 0.0, connect_error: Exception | None = None,
+                 request_error: Exception | None = None):
+        self._data = data
+        self._clock = clock
+        self._per_read_cost = per_read_cost
+        self._fail_at = fail_at
+        self._connect_cost = connect_cost
+        self._request_cost = request_cost
+        self._connect_error = connect_error
+        self._request_error = request_error
+        self.sock = FakeSocket(data, per_read_cost=per_read_cost, fail_at=fail_at)
+        self.requested = None
+        self.request_count = 0
+        self.closed = False
+
+    def _connect(self):
+        if self._connect_error is not None:
+            raise self._connect_error
+        self._clock.advance(self._connect_cost)
+
+    def request(self, method, path, body=None, headers=None):
+        self.request_count += 1
+        self.requested = (method, path, body, headers)
+        if self._request_error is not None:
+            raise self._request_error
+        self._clock.advance(self._request_cost)
+
+    def close(self):
+        self.closed = True
+        self.sock.closed = True
+
+
+class FakeFactory:
+    """connection_factory(host, port=443, timeout=remaining) -> FakeConnection."""
+
+    def __init__(self, connection: FakeConnection):
+        self.connection = connection
+        self.calls = []
+
+    def __call__(self, host, port=443, timeout=None):
+        self.calls.append({"host": host, "port": port, "timeout": timeout})
+        self.connection._connect()
+        return self.connection
+
